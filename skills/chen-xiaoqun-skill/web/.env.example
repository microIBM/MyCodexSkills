# DeepSeek API（必填）https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_MODEL=deepseek-chat
# 自定义 OpenAI 兼容网关时才需要改
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# TTS 配置（edge = 免费微软 edge-tts；minimax = MiniMax 音色克隆/系统音色）
TTS_PROVIDER=edge
TTS_VOICE=zh-CN-YunjianNeural
TTS_RATE=+10%

# MiniMax（TTS_PROVIDER=minimax 时必填）https://platform.minimaxi.com
# MINIMAX_VOICE_ID 可以是 clone_voice.py 克隆出的音色，也可以是平台系统音色 id
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_VOICE_ID=
MINIMAX_TTS_MODEL=speech-01-turbo
MINIMAX_SPEED=1.0
# 国际站等其他接入点时才需要改
# MINIMAX_BASE_URL=https://api.minimaxi.com

# 会话保留的最近轮数
MAX_HISTORY_TURNS=8

HOST=127.0.0.1
PORT=8000
